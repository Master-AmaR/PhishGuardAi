{
  "manifest_version": 3,
  "name": "PhishGuard AI Web and Mail Warning",
  "version": "0.1.0",
  "description": "Warns when websites or Gmail messages look suspicious.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>", "https://mail.google.com/*", "http://127.0.0.1:5000/*", "http://localhost:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["gmail_content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PhishGuard AI",
    "default_popup": "popup.html"
  }
}
